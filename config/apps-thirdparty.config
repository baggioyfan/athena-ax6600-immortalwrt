# ============================================================
# 第三方 feed / 仓库里的包（复刻原固件 PLUS 的"完整版"时才用）
#
# ⚠️ 这一层在三处改动之外，还会往源码树里塞若干外部仓库：
#     feed  : passwall_packages
#     clone : OpenClash、openwrt-passwall2、luci-app-partexp、istore
#   它们当初是针对旧栈 + 旧版 luci 编的，在 owrt（新栈 + JS 版 luci）
#   上**没有验证过能否编过/能否正常工作**。失败时把 APPS 降回 official 即可。
#
# 注：gowebdav 那一组（gowebdav / luci-app-gowebdav / app-meta-gowebdav）
#     在原固件里来自非标准第三方源，官方 packages feed 里没有；
#     要保留得先单独确认可用源，暂不放入本清单。
# ============================================================

# --- OpenClash（vernesong/OpenClash） ---
CONFIG_PACKAGE_luci-app-openclash=y

# --- PassWall2 + SSR（Openwrt-Passwall） ---
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y

# --- 分区扩容（sirpdboy） ---
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y

# --- iStore ---
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-lib-xterm=y
