# ============================================================
# 第三方仓库里的包（APPS=full 时才用）—— 复刻原固件 PLUS 的应用层
#
# ⚠️ 这一层在三处改动之外，还会往源码树里塞外部仓库：
#     clone : OpenClash、openwrt-passwall2、luci-app-partexp、passwall-packages
#   它们当初针对旧栈编的，在 owrt（新栈 + 内核 6.18）上能否编过没有官方保证。
#   失败时把 APPS 降回 official 即可。
#
# 已确认**不带**的东西（用户明确不要）：
#   - iStore 全家（luci-app-store / taskd / luci-lib-taskd / luci-lib-xterm）
#   - gowebdav 全家（原固件来自非标准源，官方 feed 没有）
#   - NSS 栈 kmod（kmod-qca-nss-dp/drv/ecm、qca-ssdk、nss-firmware 等）
#     → 新栈走 PPE + mainline DSA，这些包在 owrt 树上根本不存在，
#       也不需要对应替代：硬件加速由内核 flowtable/phylink 完成，无需额外 kmod
# ============================================================

# ------------------------------------------------------------
# 互斥项：必须显式改写默认变体，否则 make defconfig 会两个都选上，
# 生成出两个都 PROVIDES 同一虚拟包的 ipk，装进镜像时冲突。
# 构建脚本在编译前会硬校验这 4 行。
# ------------------------------------------------------------
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_ip-full=y
# CONFIG_PACKAGE_ip-tiny is not set

# ------------------------------------------------------------
# OpenClash（vernesong/OpenClash 0.48.x）
# 依赖：dnsmasq-full bash curl ca-bundle ip-full ruby ruby-yaml kmod-tun unzip
# ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_ruby-psych=y
CONFIG_PACKAGE_ca-bundle=y

# ------------------------------------------------------------
# PassWall2 + SSR（Openwrt-Passwall）
# 依赖：coreutils* ip-full libuci-lua lua luci-compat luci-lib-jsonc
#       lyaml resolveip tcping geoview v2ray-geoip/geosite unzip
# ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_lua=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_resolveip=y

# PassWall2 的编译期开关（默认值被显式写死，避免 defconfig 抖动）
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
# CONFIG_PACKAGE_luci-app-passwall2_Iptables_Transparent_Proxy is not set
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Haproxy=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_V2ray_Plugin=y

# nft 透明代理所需的 kmod / nft 组件
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-nat=y

# SSR（passwall-packages 子目录）
CONFIG_PACKAGE_shadowsocksr-libev-ssr-local=y
CONFIG_PACKAGE_shadowsocksr-libev-ssr-redir=y

# ------------------------------------------------------------
# 分区扩容（sirpdboy/luci-app-partexp）
# ------------------------------------------------------------
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y
