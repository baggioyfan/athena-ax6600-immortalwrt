# ============================================================
# 雅典娜 AX6600（JDCloud RE-CS-02）定制固件 seed config
#
# 源码：VIKINGYFY/immortalwrt @ owrt
#       —— 上游 PPE/DSA 新栈，DTS 里 WAN 已经是 2500base-x
# 用法：构建脚本把它拷成 .config，再追加 apps-*.config，最后 make defconfig
#
# 本次定制只有三处改动：
#   1) kmod-nft-queue          open-box 启动/接管 nft 队列需要
#   2) argon 主题 + 配置页      界面
#   3) 2.5G WAN              不靠 config，靠源码 DTS（脚本会校验）
#
# ⚠️ 不要在这里写 CONFIG_TARGET_DEVICE_PACKAGES_…=""，
#    那行会把设备自带的 DEVICE_PACKAGES（WiFi 固件 / athena-led）清空。
#    脚本已对这三个包做硬校验。

# --- 目标平台 / 设备 ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y

# --- 改动 1：nft queue（open-box 必需） ---
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
# open-box / sing-box 另外两件：旧固件有，新栈默认不一定编
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y

# --- 改动 2：argon 主题（含配置页）---
# ⚠️ 上游 immortalwrt/luci 于 2026-10-21 把独立的 applications/luci-app-argon-config
#    合并进了 themes/luci-theme-argon（3.x 起：PKG_PROVIDES:=luci-app-argon-config，
#    设置页 htdocs/.../view/argon-config.js + menu.d/luci-app-argon-config.json
#    + po/zh_Hans 全在主题包里）。
#    所以这里**不能再写** CONFIG_PACKAGE_luci-app-argon-config=y：
#    符号已不存在，defconfig 会静默丢弃，然后第 6 步硬校验报「必需包没被选上」。
#    选上主题 = 主题界面 + 配置页 + 中文翻译一起进来。
CONFIG_PACKAGE_luci-theme-argon=y
# 翻译包名仍是 luci-i18n-<basename>-<lang>，theme 的 LUCI_BASENAME:=argon-config
# 生成的就是这个；上游若再改名，第 6 步的 seed 丢弃报告会直接点出来。
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# --- 中文界面（保留配置刷机后界面语言才不会跳回英文） ---
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- 基础：一定要有 Web 界面 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y

# --- 硬件加速：新栈走 PPE + mainline DSA，内核 flowtable 即可 ---
# 旧固件的 kmod-qca-nss-dp/drv/ecm、qca-ssdk、nss-firmware 在本分支不存在，
# 也不需要功能替代（NSS 那套是闭源 QSDK 专用），故此处不留任何 NSS 相关项。
CONFIG_PACKAGE_kmod-nf-flow=y


# ============================================================
# 以下为吸收 ones20250/Openwrt-AX6600 配置的部分（2026-11-19 追加）
#
# 来源：https://github.com/ones20250/Openwrt-AX6600/blob/main/Config/GENERAL_AX6600.txt
# 他的源码是 VIKINGYFY/immortalwrt@owrt 的 fork，与我们同一棵树，符号通用。
#
# 已逐条核对，以下项**刻意没有采用**：
#   • CONFIG_PACKAGE_kmod-nft-queue=n
#        这是 open-box 的命门，我们必须 =y
#   • CONFIG_PACKAGE_iptables=n / CONFIG_PACKAGE_kmod-nf-ipt=n
#        SSR 和部分代理模式仍走 iptables，关了会出问题
#   • CONFIG_PACKAGE_luci-app-fullconenat-sonic=y
#        这个包不存在（immortalwrt/luci 里 404），界面内嵌在 firewall4
#   • CONFIG_DEVEL / CONFIG_CCACHE / CONFIG_TARGET_MULTI_PROFILE /
#     CONFIG_TARGET_PER_DEVICE_ROOTFS
#        构建期开关，对我们没有收益
#   • luci-app-sentinel / arpbind / autoreboot / samba4 / https-dns-proxy
#        个人偏好，不属于优化
# ============================================================

# --- 全锥 NAT1（SONiC）---
# 源码树自带：package/network/utils/fullconenat-sonic，PKG_VERSION:=20261116
# Makefile 里 DEFAULT:=y if PACKAGE_firewall4 —— 只要 firewall4 在，它本来就会进。
# 这里显式写一遍，防止上游哪天改了 DEFAULT 被静默丢掉。
# 前置条件：@LINUX_6_18（我们是 6.18，满足）；内核 SONiC 补丁树里已带。
# 冲突说明：它 CONFLICTS kmod-nft-fullcone / kmod-ipt-fullconenat 等 4 个旧包，
#           我们一个都没装，安全。
CONFIG_PACKAGE_fullconenat-sonic=y

# --- 内存档位 ---
# 雅典娜是 1GB DDR4。
# ⚠️ 唯一没验证成功的一条：没能找到 IPQ_MEM_PROFILE 的 Config.in 定义位置，
#    他 release 里的完整 .config 也下载不下来。若符号不存在，defconfig 会
#    静默忽略，不会让编译失败。编完用 `free -m` 对比总内存，没变化就是没生效。
CONFIG_IPQ_MEM_PROFILE_1024=y

# --- 内核用 -O2 而不是默认的 -Os ---
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y

# --- PPE 硬件转发链路：显式声明，防上游改默认值 ---
CONFIG_PACKAGE_kmod-nft-offload=y
# PassWall2 的 nftables 透明代理需要 fib / netdev 表达式
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-netdev=y

# --- eMMC 维护 + 分区扩容（partexp 扩容后靠 resize2fs）---
CONFIG_PACKAGE_fstrim=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_tune2fs=y
CONFIG_PACKAGE_block-mount=y
# mountd 与新版 fstools 冲突，ones20250 也是关掉的
CONFIG_PACKAGE_mountd=n

# --- 无线：LuCI 里能选 US 地区并拿到正确的功率上限 ---
CONFIG_PACKAGE_luci-app-wireless-regdb=y

# --- 测 2.5G 实际带宽用 ---
CONFIG_PACKAGE_iperf3=y

# --- 主动关掉：ones20250 注释写"老优化，副作用大" ---
CONFIG_PACKAGE_skb_recycler=n
