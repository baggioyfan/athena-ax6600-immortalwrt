# ============================================================
# 雅典娜 AX6600（JDCloud RE-CS-02）定制固件 seed config
#
# 源码：VIKINGYFY/immortalwrt @ owrt
#       —— 上游 PPE/DSA 新栈，DTS 里 WAN 已经是 2500base-x
# 用法：构建脚本把它拷成 .config，再 make defconfig
#
# 本次定制只有三处改动：
#   1) kmod-nft-queue          open-box 启动/接管 nft 队列需要
#   2) argon 主题 + 配置页      界面
#   3) 2.5G WAN              不靠 config，靠源码 DTS（脚本会校验）
# ============================================================

# --- 目标平台 / 设备 ---
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_jdcloud_re-cs-02=""

# --- 改动 1：nft queue（open-box 必需） ---
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nfnetlink-queue=y
# open-box / sing-box 另外两件：旧固件有，新栈默认不一定编
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y

# --- 改动 2：argon 主题 ---
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

# --- 中文界面（保留配置刷机后界面语言才不会跳回英文） ---
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- 基础：一定要有 Web 界面 ---
CONFIG_PACKAGE_luci=y
